{
  "name": "@veterancrowd/wrapped-secrets-manager-client",
  "version": "0.4.24",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VeteranCrowd/wrapped-secrets-manager-client"
  },
  "author": "Jason G. Williscroft",
  "bugs": {
    "url": "https://github.com/VeteranCrowd/wrapped-secrets-manager-client/issues"
  },
  "description": "An AWS SQS client wrapped to provide consistent logging and other services.",
  "homepage": "https://github.com/VeteranCrowd/wrapped-secrets-manager-client#readme",
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.844.0",
    "aws-xray-sdk": "^3.10.3",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.27.1",
    "@types/node": "^20.19.6",
    "@veterancrowd/aws-cli": "^6.1.4",
    "auto-changelog": "^2.5.0",
    "babel-plugin-lodash": "^3.3.4",
    "chai": "^5.2.1",
    "chai-as-promised": "^8.0.1",
    "chai-match-pattern": "^1.3.0",
    "eslint": "=8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-mocha": "^10.5.0",
    "jsdoc-to-markdown": "^8.0.3",
    "knip": "^5.61.3",
    "lefthook": "^1.12.1",
    "license-check-and-add": "^4.0.5",
    "mocha": "^10.8.2",
    "release-it": "^17.11.0",
    "uuid": "^10.0.0"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./dist/default/lib/index.js"
    }
  },
  "main": "./lib/index.js",
  "mocha": {
    "exclude": [
      "./dist/**",
      "./node_modules/**"
    ],
    "file": "./test/setup.js",
    "require": [
      "@babel/register",
      "chai-as-promised",
      "chai-match-pattern"
    ],
    "spec": "./**/*.test.!(*.*)",
    "timeout": 60000
  },
  "overrides": {
    "chai": "^5.2.1"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "requireBranch": "dev",
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true,
      "skipChecks": true
    },
    "hooks": {
      "after:init": [
        "nr lint",
        "nr test",
        "nr build"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "scripts": {
    "build": "babel lib -d dist/default/lib --delete-dir-on-start --config-file ./dist/default/.babelrc",
    "knip": "knip",
    "lint": "eslint lib/**",
    "release": "vc -c \"release-it\"",
    "release:pre": "vc -c \"release-it --no-git.requireBranch --github.prerelease --preRelease\"",
    "test": "vc -c \"mocha\""
  },
  "type": "module"
}
